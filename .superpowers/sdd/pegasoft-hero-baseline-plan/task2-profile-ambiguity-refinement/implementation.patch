+
+// Break caught: a dim bridge above minimumPeakExcess merges two significant
+// white peaks, falsely assigning a branch/contact union to one beam.
+test('beam ambiguity guard rejects significant peaks connected by a dim bridge', () => {
+  const r = profileCall(profileFixture([
+    ...isolatedProfileRows,
+    [48,52,[240,250,255]],
+    [44,47,[190,210,220]],
+  ]));
+  assert.equal(r.status, 'blocked');
+  assert.match(r.reasons.join('; '), /competing|ambiguous/i);
+  assert.equal(r.peakWidths.length, 0);
+  assert.equal(r.qualification.status, 'blocked');
+});
+// Break caught: counting each equal local maximum rejects a single plateau.
+test('beam ambiguity guard retains one flat bright plateau', () => {
+  const r = profileCall(profileFixture([[27,43,[240,250,255]]]));
+  assert.equal(r.status, 'observed-diagnostic');
+  assert.deepEqual(r.peakWidths[0].rasterBounds, [27,43]);
+  assert.equal(r.peakWidths[0].cssSpan, 8.5);
+  assert.equal(r.peakWidths[0].quantity, 'apparent-composited-bright-profile');
+  assert.equal(r.qualification.status, 'blocked');
+});
