+        __pegasoftHeroFrame?: {
+          frame?: {
+            fieldElapsedMs?: number;
+            frameId?: number;
+            rendered?: { value?: number };
+            target?: number;
+          };
+        };
+      }
+    ).__pegasoftHeroFrame;
+    const frame = record?.frame;
+    if (!frame?.frameId) throw new Error('Applied hero frame is unavailable');
+
+    return {
