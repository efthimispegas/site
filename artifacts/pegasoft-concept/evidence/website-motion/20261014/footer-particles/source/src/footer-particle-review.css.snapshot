@font-face{font-family:Manrope;src:url('/assets/review/fonts/manrope.ttf');font-weight:200 800;font-display:swap}
@font-face{font-family:DM;src:url('/assets/review/fonts/dmsans.ttf');font-weight:100 1000;font-display:swap}
*{box-sizing:border-box}body{margin:0;background:#edf2f7;color:#11151b;font:14px/1.5 DM,sans-serif}header{padding:22px 4vw;display:flex;justify-content:space-between;border-bottom:1px solid #11151b22}header a{color:inherit;text-decoration:none;font:750 24px Manrope;letter-spacing:-.05em}header span{color:#647283}main{padding:28px 4vw 40px}.intro{max-width:750px}h1{font:750 clamp(30px,4vw,48px)/1.05 Manrope;letter-spacing:-.04em;margin:8px 0 16px}.intro p{color:#647283}.wordmark-frame{height:clamp(150px,24vw,300px);position:relative;border-top:1px solid #11151b22;border-bottom:1px solid #11151b22;margin-top:24px;overflow:hidden}canvas{display:block;width:100%;height:100%;touch-action:pan-y}canvas:focus-visible{outline:3px solid #147dff;outline-offset:-4px}#pointer-guide{position:absolute;border:1px dashed #147dff88;border-radius:50%;pointer-events:none;transform:translate(-50%,-50%)}[hidden]{display:none!important}#readout{display:block;color:#647283;font:12px monospace;padding:10px 0}.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:14px 0}button,select{font:600 12px Manrope;color:#11151b;background:#fff;border:1px solid #11151b33;border-radius:6px;padding:9px 12px;cursor:pointer}button[aria-pressed=true]{background:#147dff;color:#fff;border-color:#147dff}button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #147dff;outline-offset:3px}label{display:flex;gap:8px;align-items:center}.settings{border-top:1px solid #11151b22;padding-top:12px}.settings h2{font:650 21px Manrope}#controls{display:grid;grid-template-columns:1fr 1fr;gap:14px 4vw}#controls label{display:grid;grid-template-columns:180px 1fr 65px;gap:12px}input[type=range]{width:100%;accent-color:#147dff}output{text-align:right;font:12px monospace}pre{font:12px/1.5 monospace;background:#e4ebf2;padding:14px;border-radius:6px;max-width:470px}#status{color:#647283}@media(max-width:760px){header{gap:12px;align-items:center}header span{font-size:11px}main{padding:22px 5vw}.wordmark-frame{height:160px}#controls{grid-template-columns:1fr}#controls label{grid-template-columns:150px 1fr 55px;gap:8px}}
