import {createParticleWordmark,PARTICLE_DEFAULTS,PARTICLE_PREVIOUS} from './particle-wordmark.js';
import {createScope,createFrameLoop} from '../review/runtime-lifecycle.js';
const scope=createScope(),$=s=>document.querySelector(s),canvas=$('#particle-wordmark'),particles=createParticleWordmark({canvas});
const fields=[['radius','Radius',20,300,1,'px'],['strength','Dispersion distance',.2,3,.01,'×'],['dispersionDuration','Outward duration',.1,2,.01,'s'],['returnDuration','Return duration',.1,3,.01,'s'],['returnDelay','Return delay',0,1,.01,'s'],['falloff','Edge falloff',.5,4,.05,''],['size','Particle radius',.4,1.8,.05,'px'],['spacing','Particle spacing',2,8,.25,'px']];
let running=true,reduced=window.matchMedia('(prefers-reduced-motion:reduce)').matches,hold=false,last=null,speed=1,pointer=null,lastPointer=null,sweep=null;
$('#reduced').checked=reduced;
function show(){for(const [key,,,,,unit]of fields){const input=$('#'+key);input.value=particles.settings[key];input.nextElementSibling.value=Number(input.value).toFixed(Number(input.step)<1?2:0)+unit;}$('#preset').textContent=JSON.stringify(particles.settings,null,2);}
for(const [key,label,min,max,step,unit]of fields){const row=document.createElement('label');row.append(label);const input=document.createElement('input');input.id=key;input.type='range';input.min=min;input.max=max;input.step=step;input.value=particles.settings[key];input.setAttribute('aria-label',label);const output=document.createElement('output');output.htmlFor=key;output.value=input.value+unit;row.append(input,output);$('#controls').append(row);scope.listen(input,'input',()=>{particles.configure({[key]:Number(input.value)});show();});}
function locate(value){pointer=value;if(value)lastPointer=value;particles.setPointer(value);const guide=$('#pointer-guide');guide.hidden=!value;if(value){const r=Number(canvas.dataset.interactionRadius);guide.style.width=guide.style.height=r*2+'px';guide.style.left=value.x+'px';guide.style.top=value.y+'px';}}
scope.listen(canvas,'pointermove',e=>{if(e.pointerType==='touch')return;sweep=null;const r=canvas.getBoundingClientRect();locate({x:e.clientX-r.left,y:e.clientY-r.top});});
scope.listen(canvas,'pointerleave',()=>{if(!hold)locate(null);});scope.listen(canvas,'focus',()=>locate({x:canvas.clientWidth*.5,y:canvas.clientHeight*.5}));scope.listen(canvas,'blur',()=>{if(!hold)locate(null);});
scope.listen($('#hold'),'click',()=>{hold=!hold;$('#hold').setAttribute('aria-pressed',hold);locate(hold?(lastPointer||{x:canvas.clientWidth*.5,y:canvas.clientHeight*.5}):null);});
scope.listen($('#play'),'click',()=>{running=!running;$('#play').textContent=running?'Pause':'Play';$('#play').setAttribute('aria-pressed',running);last=null;});
scope.listen($('#sweep'),'click',()=>{running=true;$('#play').textContent='Pause';$('#play').setAttribute('aria-pressed','true');sweep=0;});
scope.listen($('#return'),'click',()=>{sweep=null;locate(null);});
scope.listen($('#speed'),'change',()=>{speed=Number($('#speed').value);last=null;});scope.listen($('#reduced'),'change',()=>{reduced=$('#reduced').checked;});
for(const [id,values]of [['reset',PARTICLE_DEFAULTS],['previous',PARTICLE_PREVIOUS]])scope.listen($('#'+id),'click',()=>{particles.configure(values);particles.resize();locate(null);show();});
scope.listen($('#copy'),'click',async()=>{try{await navigator.clipboard.writeText(JSON.stringify(particles.settings,null,2));$('#status').textContent='Settings copied. Send these values for approval.';}catch{$('#status').textContent='Copy from the settings box or export JSON.';}});
scope.listen($('#export'),'click',()=>{const url=URL.createObjectURL(new window.Blob([JSON.stringify(particles.settings,null,2)+'\n'],{type:'application/json'})),a=document.createElement('a');a.href=url;a.download='pegasoft-footer-particles.json';a.click();URL.revokeObjectURL(url);});
scope.listen(window,'resize',()=>{particles.resize();locate(pointer);});scope.listen(document,'visibilitychange',()=>{last=null;});
const loop=createFrameLoop(now=>{const dt=last===null?0:Math.min((now-last)/1000,.1);last=now;if(running&&sweep!==null){sweep+=dt*speed;locate(sweep<3?{x:canvas.clientWidth*(.15+.7*sweep/3),y:canvas.clientHeight*.51}:null);if(sweep>=3)sweep=null;}particles.render(running?dt*speed:0,reduced);$('#readout').value=`${canvas.dataset.points} particles · radius ${Number(canvas.dataset.interactionRadius).toFixed(0)}px · dispersing ${canvas.dataset.dispersing} · returning ${canvas.dataset.returning}`;if(pointer)locate(pointer);});
scope.defer(()=>{loop.stop();particles.dispose();});scope.listen(window,'pagehide',()=>scope.dispose());
await particles.mount();show();canvas.particleReview={particles,get running(){return running;},get activeFrameLoops(){return loop.active?1:0;}};scope.defer(()=>delete canvas.particleReview);loop.start();
