/* Ordinary sections inherit the accepted palette and fonts without scene selectors. */
#trust-evidence{padding:36px 5vw 56px;color:var(--ink);background:var(--paper)}
.content-review-note{font:500 11px/1.5 DM;color:#63798b;margin:0 0 24px;max-width:700px}
.testimonial-row{display:grid;grid-template-columns:30% 1fr;gap:8%;border-top:1px solid #061e3b26;padding:32px 0 40px;min-height:250px}
.testimonial-identity{display:grid;grid-template-columns:80px 1fr;gap:16px;align-content:start;align-items:center}
.portrait-slot{width:80px;height:100px;border:1px dashed #71839777;display:grid;place-content:center;text-align:center;font:500 11px/1.4 DM;color:#63798b}
.testimonial-identity p{margin:0;font:500 12px/1.5 DM;color:#63798b}.testimonial-identity strong{display:block;color:#11151b;font-weight:650}
.testimonial-slot h3{font:650 clamp(22px,2.8vw,38px)/1.2 Manrope;letter-spacing:-.035em;margin:0 0 18px}.testimonial-slot p{font:400 14px/1.5 DM;color:#63798b;max-width:540px;margin:0}
#partners{padding-top:12px;scroll-margin-top:90px}.partners-intro{display:grid;grid-template-columns:30% 1fr;gap:8%;padding:20px 0;border-top:1px solid #061e3b26}.partners-intro h3{font:650 18px Manrope;margin:0}.partners-intro p{font:400 13px/1.5 DM;color:#63798b;margin:0}
.partner-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));border-left:1px solid #061e3b26;border-top:1px solid #061e3b26}
.partner-grid li{min-height:120px;display:grid;place-content:center;text-align:center;gap:8px;border-right:1px solid #061e3b26;border-bottom:1px solid #061e3b26;font:600 12px Manrope;color:#63798b}.partner-grid small{font:400 10px DM;color:#718397}
#faq{background:var(--paper);color:var(--ink);display:grid;grid-template-columns:34% 1fr;gap:8%;padding:64px 5vw 56px;scroll-margin-top:90px}
#faq h2,#contact h3{font:750 clamp(32px,4.7vw,64px)/1.03 Manrope;letter-spacing:-.04em;margin:0 0 24px}#faq h2 span,#contact h3 span{display:block;color:#718397}
.faq-intro p{font:400 13px/1.5 DM;color:#63798b;max-width:300px}.faq-list details{border-top:1px solid #061e3b26;padding:22px 0}.faq-list details:last-child{border-bottom:1px solid #061e3b26}.faq-list summary{font:600 clamp(16px,1.5vw,22px)/1.3 Manrope;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:20px}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary::after{content:'+';color:#147dff;font-size:24px;line-height:1}.faq-list details[open] summary::after{content:'−'}.faq-list details p{font:400 14px/1.65 DM;color:#63798b;margin:18px 24px 0 0;max-width:600px}.faq-list summary:focus-visible{outline:2px solid #147dff;outline-offset:6px}
#contact{display:grid;grid-template-columns:38% 1fr;gap:8%;padding:48px 0 40px;scroll-margin-top:90px}#contact p{font:400 13px/1.6 DM;color:#63798b;margin:0 0 18px;max-width:350px}
.contact-tabs{display:flex;flex-wrap:wrap;gap:0;border-bottom:1px solid #061e3b26;margin-bottom:28px}.contact-tabs button{background:none;border:0;border-radius:0;color:#63798b;font:600 12px Manrope;padding:12px 16px 12px 0;margin-right:16px}.contact-tabs button[aria-selected=true]{color:#147dff;box-shadow:inset 0 -2px #147dff}
.contact-field-plan{list-style:none;padding:0;margin:0}.contact-field-plan li{border-bottom:1px solid #061e3b26;padding:12px 0;font:500 13px DM;color:#63798b}.contact-fields-note{font:400 12px/1.5 DM;color:#63798b;margin-top:20px}
.footer-details{display:flex;gap:20px;flex-wrap:wrap;align-items:center;padding:20px 0;border-top:1px solid #061e3b26;font:400 11px DM;color:#63798b}.footer-details p{margin:0;color:inherit}.footer-details button{background:none;border:0;color:#11151b;padding:0;text-decoration:underline;text-underline-offset:4px}
#cookie-preferences{border:1px solid #71839755;border-radius:14px;background:#11151b;color:#f5f8fc;padding:28px;width:min(580px,90vw);font:400 14px/1.6 DM}#cookie-preferences::backdrop{background:#05070a99}#cookie-preferences h2{font:650 28px Manrope;letter-spacing:-.035em;margin:0 0 16px}#cookie-preferences p{color:#a8bac9}#cookie-preferences label{display:flex;gap:12px;align-items:center;border-top:1px solid #f5f8fc22;padding:18px 0}#cookie-preferences button{background:#147dff;color:#fff;border:0;border-radius:24px;padding:12px 22px;font:600 12px Manrope;margin-right:10px}#cookie-preferences button[data-close-cookies]{background:transparent;border:1px solid #7bcbff;color:#7bcbff}#cookie-status{display:block;font:400 11px DM;color:#63798b;margin:10px 0}
@media(max-width:760px){#trust-evidence{padding:28px 6% 40px}.testimonial-row{grid-template-columns:1fr;gap:24px;min-height:0;padding:26px 0 32px}.partners-intro{grid-template-columns:1fr;gap:12px}.partner-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.partner-grid li{min-height:100px}#faq{grid-template-columns:1fr;gap:24px;padding:48px 6% 40px}#contact{grid-template-columns:1fr;gap:24px;padding:32px 0}.contact-tabs button{font-size:11px;margin-right:8px;padding-right:6px}.footer-details{gap:12px}#cookie-preferences{padding:24px}}

.site-menu-toggle{display:none}#mobile-navigation{border:0;border-radius:12px;background:#edf2f7;color:#05070a;width:min(390px,90vw);padding:24px;font:500 14px DM}#mobile-navigation::backdrop{background:#05070a99}.mobile-menu-top{display:flex;justify-content:space-between;align-items:center;gap:16px;border-bottom:1px solid #061e3b26;padding-bottom:16px}.mobile-menu-top h2{font:650 20px Manrope;letter-spacing:-.035em;margin:0}#mobile-navigation button{background:none;border:0;color:#05070a;font:600 14px Manrope;padding:12px 0;text-align:left}#mobile-navigation nav{display:grid}#mobile-navigation nav button{border-bottom:1px solid #061e3b26}#mobile-navigation button:hover,#mobile-navigation button:focus-visible{color:#147dff}#mobile-navigation button:focus-visible{outline:2px solid #147dff;outline-offset:3px}@media(max-width:760px){.site-header .site-menu-toggle{display:block;margin-left:auto;padding:8px 0;font:600 11px Manrope;color:var(--header-ink)}}
