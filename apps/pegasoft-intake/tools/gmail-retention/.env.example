# Owner's private Apps Script properties, not frontend or Worker environment vars.
PEGASOFT_GMAIL_MAILBOX=
PEGASOFT_GMAIL_INTAKE_SENDER=
# May stay empty for the first preview; its exact unique user-label name is resolved
# and the actual ID is pinned only after a successful preview.
PEGASOFT_GMAIL_LABEL_ID=
PEGASOFT_GMAIL_LABEL_NAME=
PEGASOFT_GMAIL_RETENTION_DAYS=30
# Leave empty until successful preview, synthetic qualification and owner approval.
PEGASOFT_GMAIL_DELETE_READY=
# Optional synthetic-only qualification; separate label, creation and deletion gates.
PEGASOFT_GMAIL_TEST_LABEL_NAME=
PEGASOFT_GMAIL_FIXTURE_CREATE_READY=
PEGASOFT_GMAIL_FIXTURE_DELETE_READY=
