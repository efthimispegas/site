# Private Worker/provider configuration. Do not expose via frontend build vars.
# Keep disabled until storage, recipient, sender, abuse controls and privacy pass.
PEGASOFT_INTAKE_ENABLED=false
PEGASOFT_INTAKE_PATH=/api/intake
PEGASOFT_INTAKE_ORIGINS=
PEGASOFT_INTAKE_RECIPIENT=
PEGASOFT_INTAKE_SENDER=
PEGASOFT_CV_RETENTION_DAYS=30
PEGASOFT_MAX_CV_BYTES=5000000
PEGASOFT_MAX_REQUEST_BYTES=5131072
PEGASOFT_PRIVACY_VERSION=
PEGASOFT_TURNSTILE_VERIFY_URL=
PEGASOFT_TURNSTILE_SECRET=
PEGASOFT_RATE_LIMIT_SALT=
# Required platform bindings: PRIVATE_APPLICATIONS (private R2), EMAIL, LIMITER.
# Provider deployment configuration and lifecycle rules are a separate gate.
# CV policy: PDF only, 5 MB maximum. Quarantine is not malware clearance.
# R2 must have no public endpoint; enforce expiry in scheduled cleanup plus lifecycle.

# Deployment configuration; account/resource values stay outside source control.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_ORIGIN=
PEGASOFT_INTAKE_WORKER_NAME=
PEGASOFT_R2_BUCKET_NAME=
PEGASOFT_R2_JURISDICTION=eu
PEGASOFT_WORKER_COMPATIBILITY_DATE=
PEGASOFT_SOURCE_REVISION=
PEGASOFT_INTAKE_CLEANUP_CRON=*/15 * * * *
PEGASOFT_RATE_LIMIT_NAMESPACE_ID=
PEGASOFT_RATE_LIMIT_REQUESTS=5
# Protected GitHub environment only. Keep unset until this disabled deployment is approved.
PEGASOFT_INTAKE_DEPLOY_READY=
