# Absolute HTTPS origin for published metadata (no path, query or credentials).
# Set the real value in the ignored .env and Cloudflare Variables and Secrets.
# Public by design: rendered into share metadata. Never put API keys here.
PEGASOFT_PUBLIC_SITE_URL=
# Keep development and previews excluded. Set production only in the approved
# pegasoft.ai release build; Vite production mode alone does not enable indexing.
PEGASOFT_DEPLOYMENT_ENV=development

# Local development and preview servers; no personal LAN address is committed.
PEGASOFT_DEV_HOST=0.0.0.0
PEGASOFT_DEV_PORT=8770
PEGASOFT_PREVIEW_PORT=8771

# Set through provider configuration only for an approved production build.
PEGASOFT_PRODUCTION_SITE_URL=

# Contact activation is independent from Careers and requires verified backend/privacy.
PEGASOFT_CONTACT_FORM_ENABLED=false
PEGASOFT_CONTACT_QUALIFIED=false
PEGASOFT_INTAKE_PATH=/api/intake
PEGASOFT_TURNSTILE_SITE_KEY=
PEGASOFT_PRIVACY_VERSION=
PEGASOFT_PRIVACY_PATH=/privacy/
PEGASOFT_PRIVACY_APPROVED=false
PEGASOFT_COMPANY_LEGAL_NAME=
PEGASOFT_COMPANY_REGISTERED_ADDRESS=
PEGASOFT_PRIVACY_EMAIL=
# Analytics remains gated in issue57; no tracker is implemented.
PEGASOFT_ANALYTICS_ENABLED=false
